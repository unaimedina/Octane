# ---- Web client ----
# Public origin used for absolute Open Graph/Twitter URLs. Optional locally.
APP_URL=

# ---- Web client authentication ----
# Use one or both methods. Password is optional when Discord is configured.
# Plaintext password (less safe) or a hash (preferred, `npm run hash-password`).
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
# Required. At least 32 random characters. Rotating it signs everyone out.
AUTH_SECRET=
# Display name for password sessions; fallback when a Discord profile has no name.
AUTH_USERNAME=opencode
# Discord OAuth2 application. Fill all five values to enable Discord sign-in.
# Leave empty to use password sign-in only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot used to read guild roles. It must be in the guild.
DISCORD_BOT_TOKEN=
# Guild and role required to sign in.
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
# Optional. Defaults to <public-origin>/api/auth/discord/callback.
# Must match the redirect added in the Discord developer portal exactly.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Optional: true when served over HTTPS, false for plain HTTP on localhost.
# Auto-detected from x-forwarded-proto / x-forwarded-host when omitted.
AUTH_COOKIE_SECURE=

# ---- OpenCode upstream server ----
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Optional Anthropic key for the OpenCode /connect integration. You can also
# connect it from Settings -> Anthropic API key, which stores it on the server.
# Leave empty to configure providers from the app instead.
ANTHROPIC_API_KEY=

# ---- Local usage estimates ----
# Optional USD budgets used by the Usage dashboard. Leave empty to show raw usage.
USAGE_ROLLING_BUDGET_USD=
USAGE_WEEKLY_BUDGET_USD=
USAGE_MONTHLY_BUDGET_USD=

# ---- Compose-only helpers ----
# Port published by docker compose for the web client.
WEB_PORT=3000
# Host directory mounted into the OpenCode container as the project workspace.
WORKSPACE_PATH=./workspace
